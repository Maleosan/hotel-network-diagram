rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isPublicationOwner(data) {
      return request.auth != null && (
        ('ownerUid' in data && data.ownerUid == request.auth.uid) ||
        ('ownerId' in data && data.ownerId == request.auth.uid)
      );
    }

    function canReadPublishedData(data) {
      return request.auth != null && (
        data.published == true || isPublicationOwner(data)
      );
    }

    function canReadPublication(publicationId) {
      return canReadPublishedData(get(/databases/$(database)/documents/publishedDiagrams/$(publicationId)).data);
    }

    function ownsPublication(publicationId) {
      return isPublicationOwner(get(/databases/$(database)/documents/publishedDiagrams/$(publicationId)).data);
    }

    match /users/{userId} {
      allow read, create, update, delete: if isOwner(userId);

      match /diagrams/{diagramId} {
        allow read, create, update, delete: if isOwner(userId);

        match /chunks/{chunkId} {
          allow read, create, update, delete: if isOwner(userId);
        }

        match /photos/{photoId} {
          allow read, create, update, delete: if isOwner(userId);
        }

        match /changes/{changeId} {
          allow read, create, update, delete: if isOwner(userId);
        }

        match /syncStates/{publicationId} {
          allow read, create, update, delete: if isOwner(userId);
        }

        match /syncBases/{publicationId} {
          allow read, create, update, delete: if isOwner(userId);

          match /chunks/{chunkId} {
            allow read, create, update, delete: if isOwner(userId);
          }
        }
      }
    }

    match /publishedDiagrams/{publicationId} {
      allow get: if request.auth != null && (
        !exists(/databases/$(database)/documents/publishedDiagrams/$(publicationId)) ||
        canReadPublishedData(resource.data)
      );
      allow list: if request.auth != null && resource.data.published == true;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isPublicationOwner(resource.data) && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if isPublicationOwner(resource.data);

      match /changes/{changeId} {
        allow read: if canReadPublication(publicationId);
        allow create, update, delete: if ownsPublication(publicationId);
      }

      match /photos/{photoId} {
        allow read: if canReadPublication(publicationId);
        allow create, update, delete: if ownsPublication(publicationId);
      }

      match /sourceChunks/{chunkId} {
        allow read: if canReadPublication(publicationId);
        allow create, update, delete: if ownsPublication(publicationId);
      }
    }
  }
}
